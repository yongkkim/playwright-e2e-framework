{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "End-to-end tests for the Tricentis Demo Web Shop using Playwright and the Page Object Model.",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
